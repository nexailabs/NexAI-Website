	/* ════════════════════════════════════════════════════════════════════
	   POST-CYCLE CTA — universal swap-in for any agent's action bar after
	   its demo cycle completes. The CTA is rendered hidden (opacity:0,
	   pointer-events:none, position:absolute) inside the actions wrapper.
	   When .orbit__actions--post-cycle is added, the original buttons fade
	   out and the CTA fades in.
	   ════════════════════════════════════════════════════════════════════ */
	.orbit__actions {
		position: relative;
		display: grid;
		grid-template-columns: var(--orbit-actions-cols, 1fr 1fr);
		gap: 6px;
		/* min-height grows AFTER buttons fade out — prevents them being
		   stretched tall mid-fade, exposing empty space behind. */
		transition: min-height 0.32s ease 0.22s;
		/* Keep grid children at their natural height so growing min-height
		   never stretches a visible button — bar grows AROUND them. */
		align-items: center;
	}
	/* Fade the original buttons OUT first (0.22s, no delay) — then the CTA
	   fades in (see below). Sequential, not parallel, so the user never sees
	   two stacked layers mid-transition. visibility flips after opacity hits 0
	   to remove the buttons from the a11y tree and reclaim pointer focus. */
	.orbit__actions > .orbit__btn {
		transition:
			opacity 0.22s ease,
			visibility 0s linear 0.22s;
	}
	/* Two-row CTA — question label above, button-styled action below.
	   The whole anchor is clickable; the inner "action" element is what
	   visually reads as the button. */
	.orbit__post-cycle-cta {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		justify-content: center;
		gap: 7px;
		padding: 0;
		background: transparent;
		text-decoration: none;
		color: inherit;
		opacity: 0;
		pointer-events: none;
		transform: translateY(4px);
		/* Delay the CTA fade-in to AFTER the original buttons finish fading out
		   (buttons fade 0→0.22s, CTA fades 0.22→0.54s). Sequential swap reads
		   as a clean morph, not a stacked cross-fade. */
		transition:
			opacity 0.32s ease 0.22s,
			transform 0.32s ease 0.22s;
	}
	.orbit__post-cycle-cta-label {
		font-family: var(--font-body);
		font-size: 0.7rem;
		font-weight: var(--fw-semibold);
		line-height: 1.25;
		text-align: center;
		color: rgba(255, 255, 255, 0.78);
		letter-spacing: -0.005em;
	}
	.orbit__post-cycle-cta-sub {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 11px 14px;
		background: var(--brand-gradient-teal);
		color: #04130f;
		border: 1px solid rgba(78, 201, 180, 0.55);
		border-radius: 10px;
		font-family: var(--font-body);
		font-size: 0.74rem;
		font-weight: var(--fw-bold);
		letter-spacing: -0.005em;
		line-height: 1;
		box-shadow: 0 4px 14px -4px rgba(78, 201, 180, 0.45);
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}
	.orbit__post-cycle-cta:hover .orbit__post-cycle-cta-sub {
		transform: translateY(-1px);
		box-shadow: 0 7px 22px -4px rgba(78, 201, 180, 0.7);
	}
	/* Swap-in state — fade buttons out (and hide them), grow the action
	   bar to give the CTA room, fade CTA in. */
	.orbit__actions--post-cycle {
		min-height: 84px;
	}
	.orbit__actions--post-cycle > .orbit__btn {
		opacity: 0;
		pointer-events: none;
		visibility: hidden;
	}
	.orbit__actions--post-cycle > .orbit__post-cycle-cta {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	/* Light mode — post-cycle CTA */
	.home-hero--light .orbit__post-cycle-cta-label {
		color: rgba(0, 0, 0, 0.72);
	}
	.home-hero--light .orbit__post-cycle-cta-sub {
		color: #fff;
		box-shadow: 0 4px 14px -4px rgba(13, 122, 110, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		.orbit__post-cycle-cta,
		.orbit__post-cycle-cta-sub,
