			transition: none !important;
		}
		.orbit__post-cycle-cta:hover .orbit__post-cycle-cta-sub {
			transform: none !important;
		}
	}

	/* ════════════════════════════════════════════════════════════════════
	   SHARED — Card section recipe  .orbit__card-section
	   Soft-bordered rounded box for content blocks (Social content, Creatives
